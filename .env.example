# Copy file này thành .env và điền giá trị thật. Không commit .env.

# Server
NODE_ENV=development
PORT=8888
API_URL=http://localhost:8888/api

# Client URLs (dùng cho CORS + redirect)
CLIENT_URL_V1=http://localhost:5173
MOBILE_URL_V1=http://localhost:8686
COOKIE_DOMAIN=
SECURE_COOKIES=false

# Database (MongoDB connection string)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>

# JWT / Session secrets — generate bằng: openssl rand -hex 64 (JWT), openssl rand -hex 32 (session)
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailjet (gửi email/OTP)
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MJ_SENDER=

# VNPay (tuỳ chọn — bỏ trống để dùng sandbox demo mặc định trong code)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=
